# 深圳航空数字化实训平台 · AI 伴学助手大模型后端配置

# 1. 阿里云百炼 (通义千问 Qwen) - 国内免费额度大模型
# 免费获取 API Key 网址: https://bailian.console.aliyun.com/ (新注册即赠送数百万免费 Token)
DASHSCOPE_API_KEY=

# 2. 兼容接口地址 (默认阿里云千问兼容地址，亦可切换为硅基流动等平台)
# 阿里云百炼千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 硅基流动免费千问: https://api.siliconflow.cn/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 3. 默认调用的千问模型名称
# 可选: qwen-plus, qwen-turbo, qwen-max, Qwen/Qwen2.5-7B-Instruct (硅基流动)
MODEL_NAME=qwen-plus

# 4. 服务监听端口
PORT=5001

# 5. 是否开启深度思考模式 (设置为 false 将跳过推理阶段直接秒回，大幅提速；设为 true 开启慢思考)
ENABLE_THINKING=false

